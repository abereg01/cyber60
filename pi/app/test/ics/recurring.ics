BEGIN:VCALENDAR
METHOD:PUBLISH
PRODID:Microsoft Exchange Server 2010
VERSION:2.0
X-WR-CALNAME:Calendar
BEGIN:VEVENT
UID:series-weekly-sync
SUMMARY:Weekly sync
DESCRIPTION:Every Monday at 10. Starts the week before the DST change (25 Oct
  2026)\, so its first instance is 08:00 UTC and the next 09:00 UTC. 2 Nov
  deleted (EXDATE)\, 9 Nov cancelled\, 16 Nov moved to 14:00. UNTIL is the
  last instance's start: it counts.
RRULE:FREQ=WEEKLY;UNTIL=20261130T090000Z;INTERVAL=1;BYDAY=MO;WKST=MO
EXDATE;TZID=W. Europe Standard Time:20261102T100000
DTSTART;TZID=W. Europe Standard Time:20261019T100000
DTEND;TZID=W. Europe Standard Time:20261019T103000
LOCATION:Microsoft Teams Meeting
X-MICROSOFT-SKYPETEAMSMEETINGURL:https://teams.microsoft.com/l/meetup-join/19%3ameeting_V0VFS0xZ%40thread.v2/0
X-MICROSOFT-CDO-BUSYSTATUS:BUSY
END:VEVENT
BEGIN:VEVENT
UID:series-weekly-sync
RECURRENCE-ID;TZID=W. Europe Standard Time:20261109T100000
SUMMARY:Weekly sync
DTSTART;TZID=W. Europe Standard Time:20261109T100000
DTEND;TZID=W. Europe Standard Time:20261109T103000
STATUS:CANCELLED
END:VEVENT
BEGIN:VEVENT
UID:series-weekly-sync
RECURRENCE-ID;TZID=W. Europe Standard Time:20261116T100000
SUMMARY:Weekly sync (moved)
DTSTART;TZID=W. Europe Standard Time:20261116T140000
DTEND;TZID=W. Europe Standard Time:20261116T143000
END:VEVENT
BEGIN:VEVENT
UID:night-job
SUMMARY:Night job
DESCRIPTION:02:30 on 25 Oct 2026 happens twice: the first one (summer time)\, 00:30 UTC.
DTSTART;TZID=W. Europe Standard Time:20261025T023000
DTEND;TZID=W. Europe Standard Time:20261025T024500
END:VEVENT
BEGIN:VEVENT
UID:onboarding
SUMMARY:Onboarding
DESCRIPTION:Every other day\, three times: 1\, 3 and 5 Nov.
RRULE:FREQ=DAILY;INTERVAL=2;COUNT=3
DTSTART;TZID=W. Europe Standard Time:20261101T090000
DTEND;TZID=W. Europe Standard Time:20261101T100000
END:VEVENT
BEGIN:VEVENT
UID:all-hands
SUMMARY:Monthly all-hands
DESCRIPTION:The first Thursday of the month.
RRULE:FREQ=MONTHLY;INTERVAL=1;BYDAY=1TH
DTSTART;TZID=W. Europe Standard Time:20261001T150000
DTEND;TZID=W. Europe Standard Time:20261001T160000
END:VEVENT
BEGIN:VEVENT
UID:beer
SUMMARY:Last-Thursday beer
DESCRIPTION:The last Thursday of the month\, written with BYSETPOS.
RRULE:FREQ=MONTHLY;BYDAY=TH;BYSETPOS=-1
DTSTART;TZID=W. Europe Standard Time:20261029T160000
DTEND;TZID=W. Europe Standard Time:20261029T180000
X-MICROSOFT-CDO-BUSYSTATUS:TENTATIVE
END:VEVENT
BEGIN:VEVENT
UID:payday
SUMMARY:Payday
RRULE:FREQ=MONTHLY;BYMONTHDAY=15
DTSTART;VALUE=DATE:20260115
DTEND;VALUE=DATE:20260116
X-MICROSOFT-CDO-BUSYSTATUS:FREE
X-MICROSOFT-CDO-ALLDAYEVENT:TRUE
END:VEVENT
BEGIN:VEVENT
UID:birthday
SUMMARY:Mum's birthday
RRULE:FREQ=YEARLY
DTSTART;VALUE=DATE:19600606
DTEND;VALUE=DATE:19600607
TRANSP:TRANSPARENT
END:VEVENT
BEGIN:VEVENT
UID:rota
SUMMARY:Rota
DESCRIPTION:RFC 5545's WKST example: every other week on Tuesday and Sunday\,
  weeks starting on Sunday: 20 Oct\, 1 and 3 Nov\, 15 and 17 Nov (with WKST=MO
  it would be 20 and 25 Oct\, 3 and 8 Nov).
RRULE:FREQ=WEEKLY;INTERVAL=2;BYDAY=TU,SU;WKST=SU
DTSTART;TZID=W. Europe Standard Time:20261020T080000
DTEND;TZID=W. Europe Standard Time:20261020T083000
END:VEVENT
END:VCALENDAR
