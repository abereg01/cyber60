# Tools for pi/image/build-image.sh (image surgery) and pi/image/build-app.sh
# (cross-compiling the screen for the Pi's arm64 Raspberry Pi OS Trixie; Pi OS
# Lite already has the libraries these link against). The amd64 libcurl and
# libjpeg are for pi/tools/spotify-test.sh, which runs the Spotify code here;
# unzip and shellcheck for pi/tools/test-drive.sh.
FROM debian:trixie-slim
RUN dpkg --add-architecture arm64 && apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates curl xz-utils fdisk e2fsprogs mtools dosfstools util-linux python3 unzip shellcheck \
        make gcc crossbuild-essential-arm64 libdrm-dev:arm64 libcurl4-openssl-dev:arm64 libjpeg-dev:arm64 \
        libcurl4-openssl-dev libjpeg-dev \
    && rm -rf /var/lib/apt/lists/*
