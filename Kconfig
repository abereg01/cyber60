# PROSPECTOR_* Kconfig options for the prospector_screen shield.
#
# The CONFIG_PROSPECTOR_* prefix is kept from upstream Prospector (and the KLOR
# repo this screen code came from) because every layout source file references
# these symbols by name. Set them in config/prospector_dongle.conf.

choice PROSPECTOR_STATUS_SCREEN_LAYOUT
    prompt "Status screen layout"
    default PROSPECTOR_STATUS_SCREEN_SHOKO

config PROSPECTOR_STATUS_SCREEN_OPERATOR
    bool "Operator layout"
    help
        Technical and information dense layout (the rollback screen)

config PROSPECTOR_STATUS_SCREEN_SHOKO
    bool "Shoko layout"
    help
        GMK Shoko colours on white, one full-screen scene per layer with a
        keycap-row wipe between them, modifier keycap icons and a mini
        keyboard that mirrors key presses (src/layouts/shoko/).

endchoice

config PROSPECTOR_SHOKO_KEY_ECHO
    bool "Shoko layout: mirror key presses on the screen"
    default y
    depends on PROSPECTOR_STATUS_SCREEN_SHOKO
    help
      Light each pressed key on the mini keyboard, drive the WASD display on
      GAMING and the scroll wheel on SCROLL. The screen then shows where you
      type, passwords included; turn it off if that matters where it sits.

config PROSPECTOR_ROTATE_DISPLAY_180
    bool "Rotate the display 180 degrees"
    default n

config PROSPECTOR_SHOW_MODIFIERS
    bool "Display modifier key indicators (Cmd, Opt, Ctrl, Shift)"
    default y

config PROSPECTOR_MODIFIER_ORDER
    string "Modifier display order"
    default "GACS"
    depends on PROSPECTOR_SHOW_MODIFIERS
    help
      Order of modifier indicators. Use exactly 4 characters:
      G=GUI/Cmd, A=Alt/Opt, C=Control, S=Shift.
      Each character must appear exactly once.

choice PROSPECTOR_MODIFIER_OS
    prompt "Modifier key style"
    default PROSPECTOR_MODIFIER_OS_MAC
    depends on PROSPECTOR_SHOW_MODIFIERS

config PROSPECTOR_MODIFIER_OS_GENERIC
    bool "Generic (CTRL, ALT, GUI, SHFT)"

config PROSPECTOR_MODIFIER_OS_WINDOWS
    bool "Windows"

config PROSPECTOR_MODIFIER_OS_MAC
    bool "Mac"

endchoice

config PROSPECTOR_USE_AMBIENT_LIGHT_SENSOR
    bool "Use ambient light sensor for auto brightness"
    default y

config PROSPECTOR_FIXED_BRIGHTNESS
    int "Fixed display brightness"
    default 50
    range 1 100
    depends on !PROSPECTOR_USE_AMBIENT_LIGHT_SENSOR

config PROSPECTOR_LAYER_NAME_UPPERCASE
    bool "Display layer names in uppercase"
    default y
    help
      When enabled, layer names will be converted to uppercase for display.

# ── Cyber60 keyboard ─────────────────────────────────────────────────────────
# Set these in config/cyber60.conf.

config CYBER60_BUZZER
    bool "Cyber60 buzzer: sounds for the dongle link and a low battery"
    default y
    depends on BOARD_CYBER60 && $(dt_nodelabel_enabled,buzzer)
    help
      src/buzzer.c. The buzzer node is switched on in config/cyber60.overlay.

config CYBER60_BUZZER_LINK
    bool "Sound when the link to the dongle comes up or is lost"
    default y
    depends on CYBER60_BUZZER && ZMK_SPLIT && !ZMK_SPLIT_ROLE_CENTRAL
    help
      Rising "da-ding" when the link comes up (first connection after
      power-on or waking, or back after a loss), falling when it has been
      down for 3 seconds.

config CYBER60_BUZZER_BATTERY_LOW
    int "Battery percentage for the low-battery warning (two beeps)"
    default 20
    range 1 100
    depends on CYBER60_BUZZER && ZMK_BATTERY_REPORTING

config CYBER60_BUZZER_BATTERY_CRITICAL
    int "Battery percentage for the critical warning (four beeps)"
    default 10
    range 1 100
    depends on CYBER60_BUZZER && ZMK_BATTERY_REPORTING

config CYBER60_BUZZER_VOLUME
    int "Buzzer volume (1-100)"
    default 100
    range 1 100
    depends on CYBER60_BUZZER
    help
      100 = the loudest the PCB allows (its 680 ohm series resistor sets
      that). Lower values shorten the pulses, which makes it quieter.
