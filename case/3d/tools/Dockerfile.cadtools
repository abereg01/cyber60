FROM python:3.12-slim
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 libglu1-mesa libxrender1 libxcursor1 libxft2 libxinerama1 libgl1 && rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir gmsh==4.15.2 numpy trimesh matplotlib shapely networkx manifold3d scipy pillow lxml
